# Copy to .env (local) or set these in Vercel → Project → Settings → Environment Variables

# Admin panel password (CHANGE THIS!)
ADMIN_PASSWORD=change-me-please

# Random secret used to sign the admin token (any long random string)
ADMIN_SECRET=put-a-long-random-string-here

# Only needed in production on Vercel — created automatically when you add Vercel Blob.
# Leave UNSET locally to use disk storage (./data).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
